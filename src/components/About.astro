---
import { Picture } from 'astro:assets';
import { photo } from '../lib/photo-assets.ts';
import { photoMeta } from '../lib/photos.ts';
import { t, tx, type Locale } from '../i18n/index.ts';
interface Props { locale: Locale }
const { locale } = Astro.props;
const paragraphs = tx<string[]>(locale, 'about.paragraphs');
---
<section id="parcours" class="section" aria-labelledby="about-title">
  <div class="wrap grid">
    <div class="text">
      <h2 id="about-title" class="h2" data-reveal>{t(locale, 'about.title')}</h2>
      {paragraphs.map((p, i) => <p class={i === 0 ? 'lead first' : 'para'} data-reveal>{p}</p>)}
    </div>
    <figure data-reveal>
      <Picture src={photo('bcedl-vancouver-kiosque')} formats={['avif', 'webp']} alt={photoMeta['bcedl-vancouver-kiosque'].alt[locale]} widths={[480, 800, 1200]} sizes="(max-width: 52rem) 92vw, 40vw" />
    </figure>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .text { display: grid; gap: 1.1rem; }
  .first { margin-top: 0.75rem; font-weight: 500; }
  .para { max-width: 60ch; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 60% 40%; border-radius: 1rem; }
  @media (max-width: 52rem) { .grid { grid-template-columns: 1fr; } figure :global(img) { aspect-ratio: 4 / 3; } }
</style>
