---
import { localizePath, t, type Locale, type RouteId } from '../i18n/index.ts';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
interface Props { locale: Locale; route: RouteId }
const { locale, route } = Astro.props;
const home = localizePath('home', locale);
const anchor = (id: string) => (route === 'home' ? `#${id}` : `${home}#${id}`);
const links = [
  ['parcours', 'nav.journey'],
  ['salons', 'nav.salons'],
  ['competences', 'nav.skills'],
  ['ia', 'nav.ai'],
] as const;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href={home}>Seb Ji</a>
    <nav aria-label={t(locale, 'nav.home')}>
      <ul>
        {links.map(([id, key]) => <li><a href={anchor(id)}>{t(locale, key)}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <LangSwitch locale={locale} route={route} />
      <ThemeToggle locale={locale} />
      <a class="btn btn-ghost cta" href={anchor('contact')}>{t(locale, 'nav.contact')}</a>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; transition: background-color 300ms ease, box-shadow 300ms ease; }
  .site-header:global(.is-scrolled) { background: color-mix(in oklab, var(--bg) 82%, transparent); box-shadow: 0 1px 0 var(--line); backdrop-filter: saturate(1.4) blur(12px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4.25rem; }
  .wordmark { font-weight: 700; font-size: 1.0625rem; letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
  nav ul { display: flex; gap: 1.75rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--mute); text-decoration: none; font-size: 0.9375rem; transition: color 200ms ease; }
  @media (hover: hover) and (pointer: fine) { nav a:hover { color: var(--ink); } }
  .tools { display: flex; align-items: center; gap: 0.5rem; }
  .cta { min-height: 2.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; }
  @media (max-width: 52rem) { nav { display: none; } }
</style>
