---
import { t, type Locale } from '../i18n/index.ts';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label={t(locale, 'nav.themeLight')}>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px;
    color: var(--ink); background: transparent; cursor: pointer;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .theme-toggle:active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) { .theme-toggle:hover { background: color-mix(in oklab, var(--ink) 8%, transparent); } }
  .theme-toggle svg { grid-area: 1 / 1; transition: opacity 200ms ease, transform 300ms var(--ease-out); }
  :global(:root[data-theme="light"]) .sun, :global(:root:not([data-theme="light"])) .moon { opacity: 0; transform: rotate(-30deg) scale(0.8); }
</style>
