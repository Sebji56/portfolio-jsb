---
import skills from '../content/skills.json';
import { t, tx, type Locale } from '../i18n/index.ts';
import PillarTag from './PillarTag.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const pillars = ['service', 'sales', 'tech'] as const;
---
<section id="competences" class="section" aria-labelledby="skills-title">
  <div class="wrap">
    <h2 id="skills-title" class="h2" data-reveal>{t(locale, 'skills.title')}</h2>
    <ul class="pillars">
      {pillars.map((k) => (
        <li class={`pillar pillar-${k}`} data-reveal>
          <PillarTag pillar={k} label={t(locale, `pillars.${k}.name`)} />
          <ul class="list">{tx<string[]>(locale, `pillars.${k}.skills`).map((s) => <li>{s}</li>)}</ul>
        </li>
      ))}
    </ul>
    <div class="extra" data-reveal>
      <div>
        <h3 class="sub">{t(locale, 'skills.toolsTitle')}</h3>
        <dl class="tools">
          {skills.tools.map((c) => (<div><dt>{c.category[locale]}</dt><dd>{c.items.map((i) => i[locale]).join(' · ')}</dd></div>))}
        </dl>
      </div>
      <div>
        <h3 class="sub">{t(locale, 'skills.languagesTitle')}</h3>
        <dl class="tools">
          {skills.languages.map((l) => (<div><dt>{l.name[locale]}</dt><dd>{l.level[locale]}</dd></div>))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; list-style: none; padding: 0; margin: 2.5rem 0 0; }
  .pillar { padding: 1.5rem; display: grid; gap: 1.25rem; align-content: start; background: var(--surface); border: 1px solid var(--line); border-radius: 1rem; }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.65rem; }
  .extra { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(2rem, 5vw, 5rem); margin-top: 3rem; }
  .sub { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--mute); margin-bottom: 1rem; }
  .tools { display: grid; gap: 0.9rem; margin: 0; }
  .tools dt { font-weight: 600; }
  .tools dd { margin: 0.15rem 0 0; color: var(--mute); }
  @media (max-width: 60rem) { .pillars, .extra { grid-template-columns: 1fr; } }
</style>
