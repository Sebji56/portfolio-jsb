---
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '../i18n/index.ts';
import PillarTag from './PillarTag.astro';
import { Picture } from 'astro:assets';
import { photo } from '../lib/photo-assets.ts';
import { photoMeta, type PhotoId, type PhotoMeta } from '../lib/photos.ts';

interface Props { entry: CollectionEntry<'experiences'>; locale: Locale }
const { entry, locale } = Astro.props;
const d = entry.data;
const span = (s: string, e: string) => (s === e ? s : `${s} – ${e}`);
const host = d.url ? new URL(d.url).hostname.replace(/^www\./, '') : '';
---
<article class={`card exp exp-${d.kind}`} data-reveal>
  <div class="side">
    <h3>{d.company}</h3>
    <p class="meta">{d.location[locale]}{d.mode && ` · ${d.mode[locale]}`}</p>
    <p class="context">{d.context[locale]}</p>
    {d.url && (
      <a class="site" href={d.url} target="_blank" rel="noopener noreferrer">
        {host}<span class="sr-only"> {t(locale, 'experiences.newTab')}</span>
        <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M4 2h6v6M10 2 3 9" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
    )}
    {d.photo && (() => {
      const m: PhotoMeta = photoMeta[d.photo as PhotoId];
      return (
        <figure class="fig">
          <Picture class="photo" src={photo(d.photo as PhotoId)} formats={['avif', 'webp']} alt={m.alt[locale]} widths={[480, 800]} sizes="(max-width: 52rem) 88vw, 30vw" />
          {m.credit && (
            <figcaption class="credit">
              {m.creditUrl ? <a href={m.creditUrl} target="_blank" rel="noopener noreferrer">{m.credit[locale]}</a> : m.credit[locale]}
              {m.licenseUrl && <>{' · '}<a href={m.licenseUrl} target="_blank" rel="noopener noreferrer">CC BY 2.0</a></>}
            </figcaption>
          )}
        </figure>
      );
    })()}
  </div>

  <div class="main">
    <ol class={d.roles.length > 1 ? 'roles progression' : 'roles'}>
      {d.roles.map((r, i) => (
        <li class={i === 0 ? 'current' : ''}>
          <strong>{r.title[locale]}</strong>
          <time>{span(r.start, r.end)}</time>
        </li>
      ))}
    </ol>
    <ul class="wins">{d.highlights[locale].map((h) => <li>{h}</li>)}</ul>
    <div class="skills" aria-label={t(locale, 'experiences.skillsLabel')}>
      {d.skills.map((s) => <PillarTag pillar={s.pillar} label={s.label[locale]} />)}
    </div>
    {d.details && (
      <details>
        <summary>{t(locale, 'experiences.details')}</summary>
        <ul>{d.details[locale].map((x) => <li>{x}</li>)}</ul>
      </details>
    )}
  </div>
</article>

<style>
  .exp { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(1.5rem, 4vw, 3.5rem); padding: clamp(1.5rem, 3vw, 2.5rem); }
  h3 { font-size: clamp(1.625rem, 2.6vw, 2.25rem); letter-spacing: -0.035em; }
  .meta { color: var(--mute); margin-top: 0.6rem; font-size: 0.9375rem; }
  .context { margin-top: 1rem; max-width: 42ch; }
  .site { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1.1rem; color: var(--ink); font-weight: 600; font-size: 0.9375rem; text-decoration-color: var(--acc); }
  .fig { margin: 1.5rem 0 0; }
  .side :global(.photo) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: 50% 30%; border-radius: 0.75rem; }
  .credit { margin-top: 0.5rem; font-size: 0.75rem; color: var(--mute); }
  .credit a { color: inherit; }
  .main { display: grid; gap: 1.5rem; align-content: start; }
  .roles { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .roles li { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: baseline; }
  .roles strong { font-size: 1.125rem; letter-spacing: -0.02em; }
  .roles time { color: var(--mute); font-size: 0.9375rem; font-variant-numeric: tabular-nums; }
  .progression { position: relative; padding-left: 1.5rem; }
  .progression::before { content: ""; position: absolute; left: 0.3rem; top: 0.55rem; bottom: 0.55rem; width: 1px; background: linear-gradient(var(--acc), var(--line-strong)); }
  .progression li { position: relative; }
  .progression li::before { content: ""; position: absolute; left: -1.5rem; top: 0.45rem; width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--bg); box-shadow: inset 0 0 0 2px var(--line-strong); }
  .progression li.current::before { background: var(--acc); box-shadow: 0 0 0 4px color-mix(in oklab, var(--acc) 25%, transparent); }
  .wins { display: grid; gap: 0.7rem; padding-left: 1.1rem; margin: 0; }
  .wins li::marker { color: var(--acc); }
  .skills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  details { border-top: 1px solid var(--line); padding-top: 1rem; }
  summary { cursor: pointer; font-weight: 600; width: fit-content; list-style: none; display: inline-flex; align-items: center; gap: 0.5rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ""; width: 0.5rem; height: 0.5rem; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); transition: transform 200ms var(--ease-out); }
  details[open] summary::after { transform: rotate(-135deg) translateY(-1px); }
  details ul { display: grid; gap: 0.6rem; padding-left: 1.1rem; margin: 1rem 0 0; color: var(--ink); }
  .exp-project { grid-template-columns: 1fr; gap: 1.25rem; background: transparent; border-style: dashed; }
  @media (max-width: 52rem) { .exp { grid-template-columns: 1fr; } }
</style>
