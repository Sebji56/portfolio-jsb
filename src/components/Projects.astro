---
import { getCollection } from 'astro:content';
import { t, type Locale } from '../i18n/index.ts';
interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
{projects.length > 0 && (
  <section id="projets" class="section" aria-labelledby="projects-title">
    <div class="wrap">
      <h2 id="projects-title" class="h2" data-reveal>{t(locale, 'projects.title')}</h2>
      <ul class="list">
        {projects.map((p) => (
          <li class="card" data-reveal>
            <h3>{p.data.url ? <a href={p.data.url} target="_blank" rel="noopener noreferrer">{p.data.title[locale]}</a> : p.data.title[locale]}</h3>
            <p>{p.data.summary[locale]}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .list { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; list-style: none; padding: 0; margin: 2.5rem 0 0; }
  .card { padding: 1.75rem; display: grid; gap: 0.75rem; }
  h3 { font-size: 1.375rem; }
  h3 a { color: inherit; }
</style>
