---
import { Picture, getImage } from 'astro:assets';
import portrait from '../assets/photos/portrait-professionnel.jpg';
import { t, type Locale } from '../i18n/index.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const sampler = await getImage({ src: portrait, width: 300, format: 'webp' });
const steps = ['built', 'sold', 'countries'] as const;
const words = (s: string) => s.split(' ');
---
<section id="accueil" class="signal" data-signal data-portrait={sampler.src} data-locale={locale} aria-labelledby="hero-title">
  <div class="stage">
    <canvas class="canvas" aria-hidden="true"></canvas>
    <Picture class="fallback" pictureAttributes={{ class: "fallback-pic" }} formats={['avif', 'webp']} src={portrait} alt={t(locale, 'hero.portraitAlt')} widths={[360, 640, 960]} sizes="(max-width: 52rem) 80vw, 40vw" loading="eager" fetchpriority="high" />

    <div class="copy wrap">
      <div class="copy-inner" data-hero-copy>
        <h1 id="hero-title">{t(locale, 'hero.name')}</h1>
        <p class="title">{t(locale, 'hero.title')}</p>
        <p class="value">{t(locale, 'hero.value')}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#contact">{t(locale, 'hero.ctaContact')}</a>
          <a class="btn btn-ghost" href="/cv-jean-sebastien-bisson.pdf" download>{t(locale, 'hero.ctaCv')}</a>
        </div>
      </div>
    </div>

    <ol class="captions wrap" aria-label={t(locale, 'hero.storyLabel')}>
      {steps.map((s) => (
        <li class="cap" data-cap>
          <p class="when">{t(locale, `signal.${s}.when`)}</p>
          <h2>{words(t(locale, `signal.${s}.title`)).map((w, i, all) => <Fragment><span class="w">{w}</span>{i < all.length - 1 ? ' ' : ''}</Fragment>)}</h2>
          <p class="text">{t(locale, `signal.${s}.text`)}</p>
        </li>
      ))}
    </ol>

    <div class="progress" aria-hidden="true"><i data-bar></i><i data-bar></i><i data-bar></i><i data-bar></i></div>
    <p class="hint" aria-hidden="true"><i></i>{t(locale, 'hero.scroll')}</p>
  </div>
</section>

<script>
  import { startSignal } from '../lib/signal/engine.ts';
  import { cities } from '../lib/signal/cities.ts';
  import { seg, stages, wordOpacity } from '../lib/signal/timeline.ts';

  const section = document.querySelector<HTMLElement>('[data-signal]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = section?.querySelector('canvas');
  if (section && canvas && !reduce) {
    section.classList.add('signal-on');
    const progress = () => {
      const max = section.offsetHeight - innerHeight;
      return max > 0 ? Math.max(0, Math.min(1, -section.getBoundingClientRect().top / max)) : 0;
    };
    const copy = section.querySelector<HTMLElement>('[data-hero-copy]')!;
    const caps = [...section.querySelectorAll<HTMLElement>('[data-cap]')];
    const ranges: [number, number][] = [[0.3, 0.47], [0.6, 0.79], [0.81, 1.01]];
    const bars = [...section.querySelectorAll<HTMLElement>('[data-bar]')];
    const barRanges: [number, number][] = [[0.12, 0.32], [0.32, 0.5], [0.5, 0.8], [0.8, 1]];

    // Les calques de texte suivent le défilement réel (sans lissage) pour rester lisibles
    const paint = () => {
      const p = progress(), { heroOut } = stages(p);
      section.style.setProperty('--out', String(heroOut));
      copy.inert = heroOut > 0.5;
      caps.forEach((cap, i) => {
        const [a, b] = ranges[i], tin = seg(p, a, a + 0.08), tout = seg(p, b - 0.04, b);
        const ws = cap.querySelectorAll<HTMLElement>('.w');
        ws.forEach((w, k) => w.style.setProperty('--o', String(wordOpacity(tin, k, ws.length, tout))));
        cap.style.setProperty('--po', String(seg(p, a + 0.05, a + 0.1) * (1 - tout)));
      });
      bars.forEach((bar, i) => bar.style.setProperty('--f', String(seg(p, ...barRanges[i]))));
    };
    addEventListener('scroll', paint, { passive: true });
    paint();

    startSignal(canvas, {
      portraitSrc: section.dataset.portrait!,
      cities,
      locale: section.dataset.locale === 'en' ? 'en' : 'fr',
      getProgress: progress,
      onFail: () => { section.classList.remove('signal-on'); removeEventListener('scroll', paint); },
    });
  }
</script>

<style>
  /* Mode statique (sans JS, mouvement réduit ou canvas indisponible) */
  .signal { position: relative; }
  .stage { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; align-items: center; gap: 2rem; min-height: 100svh; padding-top: 5rem; }
  .canvas, .progress, .hint { display: none; }
  .signal :global(.fallback-pic) { grid-column: 2; grid-row: 1; width: 100%; max-width: 30rem; justify-self: center; }
  .signal :global(.fallback) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 1rem; }
  .copy { grid-column: 1; grid-row: 1; }
  .captions { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; list-style: none; padding-block: 3rem 5rem; margin: 0; }

  h1 { font-size: clamp(2.5rem, 5.4vw, 5.25rem); line-height: 0.95; letter-spacing: -0.04em; font-weight: 800; }
  .title { margin-top: 1.4rem; font-weight: 500; font-size: clamp(0.95rem, 1.25vw, 1.125rem); max-width: 52ch; }
  .value { margin-top: 0.8rem; color: var(--mute); font-size: clamp(1rem, 1.35vw, 1.1875rem); max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .when { font-size: 0.875rem; font-weight: 600; color: var(--acc); }
  .cap h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); margin-top: 0.5rem; }
  .cap .text { margin-top: 0.9rem; color: var(--ink); opacity: 0.85; max-width: 44ch; }

  /* Mode récit (JS + mouvement permis) */
  .signal-on { height: 520vh; }
  .signal-on .stage { position: sticky; top: 0; height: 100svh; min-height: 0; display: block; overflow: hidden; padding: 0; }
  .signal-on .canvas { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
  .signal-on :global(.fallback-pic) { display: none; }
  .signal-on .copy { position: absolute; inset: auto 0 clamp(2.5rem, 12vh, 8.75rem) 0; }
  .signal-on .copy-inner { max-width: min(40rem, 52vw); opacity: calc(1 - var(--out, 0)); transform: translateY(calc(var(--out, 0) * -30px)); }
  .signal-on .captions { position: absolute; inset: 50% 0 auto 0; transform: translateY(-50%); display: block; padding: 0; pointer-events: none; }
  .signal-on .cap { position: absolute; inset: 0 auto auto clamp(1rem, 4vw, 3.5rem); max-width: min(35rem, 44vw); transform: translateY(-50%); }
  .signal-on .cap .when, .signal-on .cap .text { opacity: var(--po, 0); transform: translateY(calc((1 - var(--po, 0)) * 10px)); }
  .signal-on .cap h2 { font-size: clamp(2.125rem, 4.4vw, 4rem); }
  .signal-on .w { display: inline-block; opacity: var(--o, 0); filter: blur(calc((1 - var(--o, 0)) * 10px)); transform: translateY(calc((1 - var(--o, 0)) * 14px)); }
  .signal-on .progress { display: grid; gap: 0.6rem; position: absolute; right: clamp(1rem, 4vw, 3.5rem); top: 50%; transform: translateY(-50%); }
  .progress i { width: 3px; height: 1.75rem; border-radius: 2px; background: var(--line-strong); position: relative; overflow: hidden; }
  .progress i::after { content: ""; position: absolute; inset: 0; background: var(--acc); transform: scaleY(var(--f, 0)); transform-origin: top; }
  .signal-on .hint { display: flex; gap: 0.6rem; align-items: center; position: absolute; right: clamp(1rem, 4vw, 3.5rem); bottom: 2rem; font-size: 0.8125rem; color: var(--mute); opacity: calc(1 - var(--out, 0)); }
  .hint i { width: 1px; height: 2.25rem; background: linear-gradient(var(--acc), transparent); animation: drip 1.6s var(--ease-out) infinite; transform-origin: top; }
  @keyframes drip { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  @media (max-width: 52rem) {
    .stage { grid-template-columns: 1fr; padding-top: 5.5rem; }
    .signal :global(.fallback-pic) { grid-column: 1; grid-row: 1; max-width: 18rem; }
    .copy { grid-row: 2; }
    .captions { grid-template-columns: 1fr; }
    .signal-on .progress { display: none; }
    .signal-on .copy-inner { max-width: none; }
    .signal-on .value { display: none; }
    .signal-on .cap { inset: auto 1rem 2.5rem 1rem; max-width: none; transform: none; }
    .signal-on .captions { inset: 0; transform: none; }
  }
</style>
