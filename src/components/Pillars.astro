---
import { t, tx, type Locale } from '../i18n/index.ts';
import PillarTag from './PillarTag.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const keys = ['service', 'sales', 'tech'] as const;
---
<section id="piliers" class="section" aria-labelledby="pillars-title">
  <div class="wrap">
    <div class="head">
      <h2 id="pillars-title" class="h2" data-reveal>{t(locale, 'pillars.title')}</h2>
      <p class="lead" data-reveal>{t(locale, 'pillars.intro')}</p>
    </div>
    <ul class="grid">
      {keys.map((k) => (
        <li class={`card pillar pillar-${k}`} data-reveal>
          <PillarTag pillar={k} label={t(locale, `pillars.${k}.name`)} />
          <ul class="skills">
            {tx<string[]>(locale, `pillars.${k}.skills`).map((s) => <li>{s}</li>)}
          </ul>
          <p class="proof"><span>{t(locale, 'pillars.proofLabel')}</span> {t(locale, `pillars.${k}.proof`)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end; margin-bottom: 3rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; list-style: none; padding: 0; margin: 0; }
  .pillar { padding: 1.75rem; display: grid; gap: 1.5rem; align-content: start; position: relative; overflow: hidden; }
  .pillar::before { content: ""; position: absolute; inset: -40% 40% auto -20%; height: 70%; background: radial-gradient(closest-side, var(--glow), transparent); opacity: 0.14; pointer-events: none; }
  .pillar-service { --glow: var(--pillar-service); }
  .pillar-sales { --glow: var(--pillar-sales); }
  .pillar-tech { --glow: var(--pillar-tech); }
  .skills { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; font-size: 1.0625rem; }
  .skills li { padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); }
  .proof { color: var(--mute); font-size: 0.9375rem; }
  .proof span { color: var(--ink); font-weight: 600; }
  @media (max-width: 60rem) { .head, .grid { grid-template-columns: 1fr; } }
</style>
