---
import Base from '../layouts/Base.astro';
import { t, type Locale } from '../i18n/index.ts';
import SignalHero from './SignalHero.astro';
import KeyFigures from './KeyFigures.astro';
import About from './About.astro';
import Skills from './Skills.astro';
import Emerging from './Emerging.astro';
import Education from './Education.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import Experiences from './Experiences.astro';
import Aisle from './Aisle.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<Base locale={locale} route="home" title={t(locale, 'meta.homeTitle')} description={t(locale, 'meta.homeDescription')}>
  <SignalHero locale={locale} />
  <KeyFigures locale={locale} />
  <About locale={locale} />
  <Experiences locale={locale} />
  <Aisle locale={locale} />
  <Skills locale={locale} />
  <Emerging locale={locale} />
  <Education locale={locale} />
  <Projects locale={locale} />
  <Contact locale={locale} />
</Base>

<script>
  import { initReveal } from '../lib/reveal.ts';
  initReveal();
</script>
